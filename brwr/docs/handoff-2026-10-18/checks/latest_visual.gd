extends "res://docs/handoff-2026-10-18/checks/avatar_board_ui.gd"
func run():
 root.size = Vector2i(1600,1000)
 game = await create_game()
 reset_case()
 game.players[AVATAR].trophies.assign([0,1,2])
 game.avatar_board.refresh()
 expect(game.avatar_board.cards_root.get_node("AvatarTrophies").get_child_count() == 3, "Avatar trophies displayed with owner colors")
 game.table_shell.open_board(AVATAR)
 await capture("latest-avatar-trophies")
 game.table_shell.close_board()
 game.table_shell._cancel_animation()
 game.table_shell._observe(false)
 game.players[1].mage.damage_cubes.assign([0,0])
 game.refresh_all_player_boards()
 game.table_shell.queue_damage_placement(1,0,[0,0])
 expect(game.table_shell.animation_queue.filter(func(e): return e.kind == "damage").size() == 2, "Each received damage cube queues a placement animation")
 game.table_shell._play_next_animation()
 expect(game.table_shell.shown_player == 1 and game.table_shell.animation != null, "Damage opens target board and starts tween")
 await capture("latest-damage-animation")
 game.table_shell._cancel_animation()
 game.players[1].mage.damage_cubes.clear()
 game.refresh_all_player_boards()
 game.table_shell.queue_damage_placement(1,9,[0,0,0,0,0,0,0,0,0,2,2])
 game.table_shell._play_next_animation()
 expect(game.table_shell.animated_damage_ghost and game.table_shell.animated_node != null, "Lethal damage snapshot animates even after defeat clears cubes")
 expect(game.players[1].mage.damage_cubes.is_empty(), "Damage animation never restores authoritative cubes")
 game.table_shell._cancel_animation()
 game.run_tests_on_ready = false
 game.animate_model_attack(0,1)
 game.run_tests_on_ready = true
 await capture("latest-attack-animation")
 game.current_effect_description = "Assign a Destiny Token."
 game.request_effect_choice(0,"evocation_target",{},"chosen",[{"token":"ev","value":1,"name":"Colossus"}],1,1,"Choose an Evocation.")
 game.beta_hud._process(0)
 expect(game.pending_input.effect_description == "Choose an Evocation.", "Visible decision matches current target")
 await capture("latest-choice-box")
 print("LATEST VISUAL: ",checks," checks; failures: ",failures)
 quit(0 if failures.is_empty() else 1)
